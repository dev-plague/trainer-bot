# Copia este archivo a `.env` y ajusta lo que necesites. `.env` no se versiona.

# PostgreSQL local (docker-compose publica 5433 para no chocar con 5432).
DATABASE_URL="postgresql://trainerbot:trainerbot@localhost:5433/trainerbot"

# Better Auth.
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
